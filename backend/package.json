{
  "name": "talento-caribe-backend",
  "version": "1.0.0",
  "description": "Servidor de Talento Caribe: sirve la página web y la API conectada a PostgreSQL",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:actualizar": "node scripts/actualizar-db.js",
    "db:reiniciar": "node scripts/init-db.js --reiniciar"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.0"
  }
}
