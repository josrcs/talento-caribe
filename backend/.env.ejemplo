# Copia este archivo como .env y cambia TU_CONTRASEÑA por la clave del usuario postgres
# que pusiste al instalar PostgreSQL. El archivo .env NUNCA se sube a GitHub.
PORT=3000
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/talento_caribe
# Solo para bases en la nube (Render, Neon, Supabase...): activa la conexión cifrada
# DATABASE_SSL=true

# Clave secreta para firmar las sesiones (JWT): mínimo 32 caracteres aleatorios. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Quien la conozca podría fabricar sesiones de administrador: nunca la subas a GitHub.
# En producción (NODE_ENV=production o Render) el servidor no arranca si falta o es la de este ejemplo.
JWT_SECRETO=cambia-esto-por-un-texto-largo-y-secreto-de-talento-caribe

# Asistente con IA real (Claude). Crea la clave en https://platform.claude.com → API Keys.
# Sin esta línea el asistente sigue funcionando con respuestas locales.
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo (opcional). Por defecto: claude-opus-5-5
# IA_MODELO=claude-opus-5-5
# Máximo de mensajes al asistente por día en toda la plataforma (controla el gasto). Por defecto: 500
# IA_LIMITE_DIARIO=500

# Correos (bienvenida, recuperar contraseña, avisos de inscripción y del formulario de contacto).
# Sin estas líneas no se envían: aparecen en la terminal del servidor para poder probarlos.
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (16 letras, sin espacios).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=tu-correo@gmail.com
# SMTP_CLAVE=la-contraseña-de-aplicación
# CORREO_REMITENTE=Talento Caribe <tu-correo@gmail.com>
# A dónde llega la copia de cada mensaje del formulario de contacto (opcional)
# CORREO_EQUIPO=tu-correo@gmail.com
# Dirección de la página para los enlaces de los correos (en GitHub Pages: https://tu-usuario.github.io/talento-caribe)
# SITIO_URL=http://localhost:3000

# Dominios extra que pueden usar la API (separados por coma), por ejemplo la página en GitHub Pages
# CORS_ORIGENES=https://tu-usuario.github.io
