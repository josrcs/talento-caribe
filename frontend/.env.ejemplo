# Variables opcionales del frontend (copia este archivo como .env si necesitas cambiarlas).
# Vite solo publica en la página las variables que empiezan por VITE_. Nunca pongas claves secretas aquí:
# todo lo que está en el frontend lo puede ver cualquier persona.

# Dirección de la API. Si no la pones:
#  - en tu computador se usa "/api" (Vite la reenvía al backend en localhost:3000)
#  - en GitHub Pages se usa la API publicada en Render (API_PUBLICADA en src/lib/config.js)
# VITE_API_URL=https://talento-caribe-api.onrender.com/api

# Ruta del sitio en GitHub Pages, para la página 404 (la pone sola la acción de GitHub)
# VITE_BASE_404=/talento-caribe/
